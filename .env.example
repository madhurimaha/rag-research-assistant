# ---------------------------------------------------------------- infra
DATABASE_URL=postgresql://rag:rag@localhost:5435/rag
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- LLM provider
# Ingestion, retrieval and reranking need NO key — embeddings and the cross-encoder
# run locally via ONNX. A provider is needed only for answer generation, optional
# chunk contextualisation, and LLM-judge eval metrics.
#
# Three tiers:
#   openai | anthropic  hosted, best quality, needs an API key
#   ollama              local open-weights model: real generation, no key, no cost
#   none                retrieval-only — the app still runs and shows ranked evidence
LLM_PROVIDER=none

# --- hosted
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- local, no key required
#   brew install ollama && ollama serve
#   ollama pull qwen3:8b        (~5GB, ~20-38 tok/s on an M1 Pro)
# then set LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Leave blank to use the provider's default model.
GENERATION_MODEL=
CONTEXT_MODEL=
# Prefer a different model family than GENERATION_MODEL to avoid self-preference bias.
JUDGE_MODEL=

# ---------------------------------------------------------------- pipeline
# Index-time enrichment (Anthropic-style contextual retrieval). Needs an LLM key.
CONTEXTUALIZE=false

CHUNK_TARGET_TOKENS=320
CHUNK_OVERLAP_TOKENS=64

# ---------------------------------------------------------------- retrieval
# Values below are the empirically chosen defaults — see data/eval/results/retrieval_ablation.md
USE_HYBRID=true
USE_RERANK=true
RERANK_DEPTH=20
CANDIDATES_PER_ARM=50
RRF_K=60
HNSW_EF_SEARCH=100
FINAL_CONTEXT_CHUNKS=6

# ---------------------------------------------------------------- frontend (web/.env.local, optional)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Raw retrieval-score table inside "Why this answer?". The plain-language summary is always shown.
# Defaults to on so a clone demonstrates the full pipeline; set false for untrusted users.
# NEXT_PUBLIC_SHOW_DIAGNOSTICS=true
